        f"Wave: {wave}",
        FONT,
        WHITE,
        WIDTH - 180,
        20
    )

    draw_text(
        f"Score: {score}",
        FONT,
        WHITE,
        WIDTH - 180,
        52
    )

    draw_text(
        f"Coins: {player.coins}",
        FONT,
        YELLOW,
        WIDTH - 180,
        84
    )

    draw_text(
        f"Kills: {player.kills}",
        FONT,
