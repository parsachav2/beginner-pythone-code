        dash_color = GRAY

    draw_text(
        dash_text,
        FONT_SMALL,
        dash_color,
        20,
        HEIGHT - 30
    )

    draw_text(
        "WASD: Move   Mouse: Aim   LMB: Shoot   P: Pause",
        FONT_SMALL,
        GRAY,
        300,
        HEIGHT - 30
    )


# ============================================================
# Main game loop
# ============================================================

reset_game()

running = True

while running:

    dt = clock.tick(FPS) / 1000.0

    # Limit dt
    dt = min(dt, 0.05)

    # --------------------------------------------------------
    # Events
    # --------------------------------------------------------

    for event in pygame.event.get():

        if event.type == pygame.QUIT:
            running = False

        if event.type == pygame.KEYDOWN:

            if event.key == pygame.K_ESCAPE:
                running = False

            if event.key == pygame.K_p:

                if game_state == PLAYING:
                    game_state = PAUSED

                elif game_state == PAUSED:
                    game_state = PLAYING

            if event.key == pygame.K_SPACE:

                if game_state == PLAYING:
                    player.dash()

            if event.key == pygame.K_r:

                if game_state == GAME_OVER:
                    reset_game()

        if event.type == pygame.MOUSEBUTTONDOWN:

            if event.button == 1 and game_state == PLAYING:
                bullet = player.shoot(*pygame.mouse.get_pos())

                if bullet:
                    bullets.append(bullet)

    # --------------------------------------------------------
    # Playing
    # --------------------------------------------------------

    if game_state == PLAYING:

        player.update(dt)

        # ----------------------------
        # Shooting
        # ----------------------------

        mouse_buttons = pygame.mouse.get_pressed()

        if mouse_buttons[0]:
            bullet = player.shoot(*pygame.mouse.get_pos())

            if bullet:
                bullets.append(bullet)

        # ----------------------------
        # Wave spawning
        # ----------------------------

        spawn_timer -= dt

        if spawned_this_wave < enemies_to_spawn:

            if spawn_timer <= 0:

                enemies.append(
                    Enemy(player.level)
                )

                spawned_this_wave += 1

                # Spawn faster at higher waves
                spawn_timer = max(
                    0.12,
                    0.65 - wave * 0.015
                )

        elif len(enemies) == 0:

            wave += 1

            enemies_to_spawn = 8 + wave * 3
            spawned_this_wave = 0

            message = f"WAVE {wave}!"
            message_timer = 2

            # Small reward for clearing wave
            player.coins += 5

        # ----------------------------
        # Bullets
        # ----------------------------

        for bullet in bullets:
            bullet.update(dt)

        bullets = [
            bullet for bullet in bullets
            if bullet.alive()
        ]

        # ----------------------------
        # Enemies
        # ----------------------------

        for enemy in enemies:
            enemy.update(player, dt)

        # ----------------------------
        # Bullet vs enemy collision
        # ----------------------------

        bullets_to_remove = set()
        enemies_to_remove = set()

        for bullet in bullets:

            for enemy in enemies:

                if id(enemy) in enemies_to_remove:
                    continue

                if id(bullet) in bullets_to_remove:
                    continue

                if circle_collision(
                    bullet.x,
                    bullet.y,
                    bullet.radius,
                    enemy.x,
                    enemy.y,
                    enemy.radius
                ):

                    enemy.health -= bullet.damage
                    enemy.hit_flash = 0.08

                    bullets_to_remove.add(id(bullet))

                    create_particles(
                        bullet.x,
                        bullet.y,
                        YELLOW,
                        5
                    )

                    if enemy.health <= 0:

                        enemies_to_remove.add(id(enemy))

                        player.kills += 1
                        score += 10 * wave

                        # XP
                        gem = Gem(
                            enemy.x,
                            enemy.y,
                            enemy.xp
                        )

                        gems.append(gem)

                        # Coins
                        if random.random() < 0.35:
                            coins.append(
                                Coin(
                                    enemy.x,
                                    enemy.y
                                )
                            )

                        create_particles(
                            enemy.x,
                            enemy.y,
                            enemy.color,
                            18
                        )

        bullets = [
            b for b in bullets
            if id(b) not in bullets_to_remove
        ]

        enemies = [
            e for e in enemies
            if id(e) not in enemies_to_remove
        ]

        # ----------------------------
        # Enemy vs player
        # ----------------------------

        for enemy in enemies:

            if circle_collision(
                player.x,
                player.y,
                player.radius,
                enemy.x,
                enemy.y,
                enemy.radius
            ):

                if player.take_damage(enemy.damage):

                    create_particles(
                        player.x,
                        player.y,
                        RED,
                        10
                    )

                    # Push enemy away
                    dx = enemy.x - player.x
                    dy = enemy.y - player.y

                    length = math.hypot(dx, dy)

                    if length == 0:
                        length = 1

                    enemy.x += dx / length * 30
                    enemy.y += dy / length * 30

        # ----------------------------
        # Gems
        # ----------------------------

        for gem in gems:
            gem.update(dt)

            if circle_collision(
                player.x,
                player.y,
                player.radius + 8,
                gem.x,
                gem.y,
                gem.radius
            ):

                leveled_up = player.add_xp(gem.value)

                create_particles(
                    gem.x,
                    gem.y,
                    CYAN,
                    8
                )

                if leveled_up:

                    message = f"LEVEL {player.level}!"
                    message_timer = 2

                    create_particles(
                        player.x,
                        player.y,
                        CYAN,
                        35
                    )

        gems = [
            g for g in gems
            if not circle_collision(
                player.x,
                player.y,
                player.radius + 8,
                g.x,
                g.y,
                g.radius
            )
        ]

        # ----------------------------
        # Coins
        # ----------------------------

        for coin in coins:
            coin.update(dt)

        collected_coins = []

        for coin in coins:

            if circle_collision(
                player.x,
                player.y,
                player.radius,
                coin.x,
                coin.y,
                coin.radius
            ):

                collected_coins.append(coin)
                player.coins += 1
                score += 25

                create_particles(
                    coin.x,
                    coin.y,
                    YELLOW,
                    10
                )

        coins = [
            c for c in coins
            if c not in collected_coins
        ]

        # ----------------------------
        # Particles
        # ----------------------------

        for particle in particles:
            particle.update(dt)

        particles = [
            p for p in particles
            if p.life > 0
        ]

        # ----------------------------
        # Message timer
        # ----------------------------

        message_timer = max(
            0,
            message_timer - dt
        )

        # ----------------------------
        # Game over
        # ----------------------------

        if player.health <= 0:

            player.health = 0
            game_state = GAME_OVER

            create_particles(
                player.x,
                player.y,
                RED,
                50
            )

    # --------------------------------------------------------
    # Draw
    # --------------------------------------------------------

    draw_background()

    # Gems
    for gem in gems:
        gem.draw()

    # Coins
    for coin in coins:
        coin.draw()

    # Bullets
    for bullet in bullets:
        bullet.draw()

    # Enemies
    for enemy in enemies:
        enemy.draw()

    # Player
    player.draw()

    # Particles
    for particle in particles:
        particle.draw()

    # HUD
    draw_hud()

    # --------------------------------------------------------
    # Message
    # --------------------------------------------------------

    if message_timer > 0:

        alpha = min(
            255,
            int(message_timer * 255)
        )

        text_surface = FONT_BIG.render(
            message,
            True,
            WHITE
        )

        text_surface.set_alpha(alpha)

        rect = text_surface.get_rect(
            center=(WIDTH // 2, 110)
        )

        screen.blit(
            text_surface,
            rect
        )

    # --------------------------------------------------------
    # Pause screen
    # --------------------------------------------------------

    if game_state == PAUSED:

        overlay = pygame.Surface(
            (WIDTH, HEIGHT),
            pygame.SRCALPHA
        )

        overlay.fill((0, 0, 0, 150))
        screen.blit(overlay, (0, 0))

        draw_text(
            "PAUSED",
            FONT_HUGE,
            WHITE,
            WIDTH // 2,
            HEIGHT // 2 - 50,
            center=True
        )

        draw_text(
            "Press P to continue",
            FONT,
            GRAY,
            WIDTH // 2,
            HEIGHT // 2 + 25,
            center=True
        )

    # --------------------------------------------------------
    # Game over screen
    # --------------------------------------------------------

    if game_state == GAME_OVER:

        overlay = pygame.Surface(
            (WIDTH, HEIGHT),
            pygame.SRCALPHA
        )

        overlay.fill((0, 0, 0, 175))
        screen.blit(overlay, (0, 0))

        draw_text(
            "GAME OVER",
            FONT_HUGE,
            RED,
            WIDTH // 2,
            HEIGHT // 2 - 100,
            center=True
        )  

        draw_text(
            f"Score: {score}",
            FONT_BIG,
            WHITE,
            WIDTH // 2,
            HEIGHT // 2 - 20,
            center=True
        )

        draw_text(
            f"Wave reached: {wave}",
            FONT,
            WHITE,
            WIDTH // 2,
            HEIGHT // 2 + 30,
            center=True
        )

        draw_text(
            f"Kills: {player.kills}",
            FONT,
            WHITE,
            WIDTH // 2,
            HEIGHT // 2 + 70,
            center=True
        )

        draw_text(
            "Press R to restart",
            FONT,
            YELLOW,
            WIDTH // 2,
            HEIGHT // 2 + 130,
            center=True
        )

    pygame.display.flip()


pygame.quit()
sys.exit()

