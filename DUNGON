# ============================================================
# Helper functions
# ============================================================

def clamp(value, minimum, maximum):
    return max(minimum, min(value, maximum))


def distance(x1, y1, x2, y2):
    return math.hypot(x2 - x1, y2 - y1)


def draw_text(text, font, color, x, y, center=False):
    surface = font.render(text, True, color)

    if center:
        rect = surface.get_rect(center=(x, y))
    else:
        rect = surface.get_rect(topleft=(x, y))

    screen.blit(surface, rect)


def circle_collision(a_x, a_y, a_radius, b_x, b_y, b_radius):
    return distance(a_x, a_y, b_x, b_y) < a_radius + b_radius


# ============================================================
# Particle
# ============================================================

class Particle:
    def __init__(self, x, y, color):
        self.x = x
        self.y = y
        angle = random.uniform(0, math.pi * 2)
        speed = random.uniform(40, 180)

        self.vx = math.cos(angle) * speed
        self.vy = math.sin(angle) * speed

        self.life = random.uniform(0.25, 0.7)
        self.max_life = self.life
        self.size = random.randint(2, 5)
        self.color = color

    def update(self, dt):
        self.x += self.vx * dt
        self.y += self.vy * dt

        self.vx *= 0.96
        self.vy *= 0.96

        self.life -= dt

    def draw(self):
        if self.life <= 0:
            return

        size = max(1, int(self.size * (self.life / self.max_life)))
        pygame.draw.circle(
            screen,
            self.color,
            (int(self.x), int(self.y)),
            size
        )


# ============================================================
# Bullet
# ============================================================

class Bullet:
    def __init__(self, x, y, target_x, target_y, damage):
        self.x = x
        self.y = y

        dx = target_x - x
        dy = target_y - y

        length = math.hypot(dx, dy)

        if length == 0:
            length = 1

        self.vx = dx / length * 750
        self.vy = dy / length * 750

        self.radius = 5
        self.damage = damage
        self.life = 1.2

    def update(self, dt):
        self.x += self.vx * dt
        self.y += self.vy * dt
        self.life -= dt

    def draw(self):
        pygame.draw.circle(
            screen,
            YELLOW,
            (int(self.x), int(self.y)),
            self.radius
        )

    def alive(self):
        return (
            self.life > 0
            and -20 < self.x < WIDTH + 20
            and -20 < self.y < HEIGHT + 20
        )


# ============================================================
# Coin
# ============================================================

class Coin:
    def __init__(self, x, y):
        self.x = x
        self.y = y
        self.radius = 9
        self.bob = random.uniform(0, math.pi * 2)

    def update(self, dt):
        self.bob += dt * 4

    def draw(self):
        offset = math.sin(self.bob) * 3

        pygame.draw.circle(
            screen,
            YELLOW,
            (int(self.x), int(self.y + offset)),
            self.radius
        )

        pygame.draw.circle(
            screen,
            ORANGE,
            (int(self.x), int(self.y + offset)),
            self.radius,
            2
        )


# ============================================================
# XP Gem
# ============================================================

class Gem:
    def __init__(self, x, y, value=10):
        self.x = x
        self.y = y
        self.value = value
        self.radius = 7
        self.angle = random.uniform(0, math.pi * 2)

    def update(self, dt):
        self.angle += dt * 3

    def draw(self):
        y_offset = math.sin(self.angle) * 3

        points = [
            (self.x, self.y - self.radius + y_offset),
            (self.x + self.radius, self.y + y_offset),
            (self.x, self.y + self.radius + y_offset),
            (self.x - self.radius, self.y + y_offset)
        ]

        pygame.draw.polygon(screen, CYAN, points)


# ============================================================
# Enemy
# ============================================================

class Enemy:
    def __init__(self, level):
        side = random.randint(0, 3)

        if side == 0:
            self.x = random.randint(0, WIDTH)
            self.y = -40
        elif side == 1:
            self.x = WIDTH + 40
            self.y = random.randint(0, HEIGHT)
        elif side == 2:
            self.x = random.randint(0, WIDTH)
            self.y = HEIGHT + 40
        else:
            self.x = -40
            self.y = random.randint(0, HEIGHT)

        # Different enemy types
        roll = random.random()

        if roll < 0.72:
            # Normal enemy
            self.kind = "normal"
            self.radius = 18
            self.speed = random.uniform(80, 125) + level * 3
            self.max_health = 30 + level * 7
            self.damage = 8 + level
            self.color = RED
            self.xp = 12

        elif roll < 0.92:
            # Fast enemy
            self.kind = "fast"
            self.radius = 13
            self.speed = random.uniform(150, 200) + level * 4
            self.max_health = 18 + level * 4
            self.damage = 5 + level
            self.color = ORANGE
            self.xp = 18

        else:
            # Tank enemy
            self.kind = "tank"
            self.radius = 28
            self.speed = random.uniform(45, 70) + level * 2
            self.max_health = 100 + level * 15
            self.damage = 18 + level * 2
            self.color = PURPLE
            self.xp = 35

        self.health = self.max_health
        self.hit_flash = 0

    def update(self, player, dt):
        dx = player.x - self.x
        dy = player.y - self.y

        length = math.hypot(dx, dy)

        if length > 0:
            self.x += dx / length * self.speed * dt
            self.y += dy / length * self.speed * dt

        self.hit_flash = max(0, self.hit_flash - dt)

    def draw(self):
        color = WHITE if self.hit_flash > 0 else self.color

        pygame.draw.circle(
            screen,
            color,
            (int(self.x), int(self.y)),
            self.radius
        )

        # Eyes
        pygame.draw.circle(
            screen,
            BLACK,
            (int(self.x - self.radius * 0.35),
             int(self.y - self.radius * 0.15)),
            max(2, self.radius // 5)
        )

        pygame.draw.circle(
            screen,
            BLACK,
            (int(self.x + self.radius * 0.35),
             int(self.y - self.radius * 0.15)),
            max(2, self.radius // 5)
        )

        # Health bar
        if self.health < self.max_health:
            bar_width = self.radius * 2
            health_width = int(
                bar_width * self.health / self.max_health
            )

            pygame.draw.rect(
                screen,
                BLACK,
                (
                    int(self.x - self.radius),
                    int(self.y - self.radius - 10),
                    bar_width,
                    5
                )
            )

            pygame.draw.rect(
                screen,
                GREEN,
                (
                    int(self.x - self.radius),
                    int(self.y - self.radius - 10),
                    health_width,
                    5
                )
            )


# ============================================================
# Player
# ============================================================

class Player:
    def __init__(self):
        self.x = WIDTH // 2
        self.y = HEIGHT // 2

        self.radius = 20

        self.speed = 270

        self.max_health = 100
        self.health = self.max_health

        self.damage = 25
        self.fire_rate = 0.22
        self.fire_timer = 0

        self.level = 1
        self.xp = 0
        self.xp_needed = 100

        self.coins = 0
        self.kills = 0

        self.invincible = 0

        self.dash_cooldown = 0
        self.dash_duration = 0

        self.last_dx = 1
        self.last_dy = 0

    def update(self, dt):
        keys = pygame.key.get_pressed()

        dx = 0
        dy = 0

        if keys[pygame.K_w] or keys[pygame.K_UP]:
            dy -= 1

        if keys[pygame.K_s] or keys[pygame.K_DOWN]:
            dy += 1

        if keys[pygame.K_a] or keys[pygame.K_LEFT]:
            dx -= 1

        if keys[pygame.K_d] or keys[pygame.K_RIGHT]:
            dx += 1

        if dx != 0 or dy != 0:
            length = math.hypot(dx, dy)

            dx /= length
            dy /= length

            self.last_dx = dx
            self.last_dy = dy

            self.x += dx * self.speed * dt
            self.y += dy * self.speed * dt

        self.x = clamp(
            self.x,
            self.radius,
            WIDTH - self.radius
        )

        self.y = clamp(
            self.y,
            self.radius,
            HEIGHT - self.radius
        )

        self.fire_timer = max(0, self.fire_timer - dt)
        self.invincible = max(0, self.invincible - dt)
        self.dash_cooldown = max(0, self.dash_cooldown - dt)
        self.dash_duration = max(0, self.dash_duration - dt)

    def shoot(self, target_x, target_y):
        if self.fire_timer > 0:
            return None

        self.fire_timer = self.fire_rate

        return Bullet(
            self.x,
            self.y,
            target_x,
            target_y,
            self.damage
        )

    def dash(self):
        if self.dash_cooldown > 0:
            return

        keys = pygame.key.get_pressed()

        dx = 0
        dy = 0

        if keys[pygame.K_w] or keys[pygame.K_UP]:
            dy -= 1
        if keys[pygame.K_s] or keys[pygame.K_DOWN]:
            dy += 1
        if keys[pygame.K_a] or keys[pygame.K_LEFT]:
            dx -= 1
        if keys[pygame.K_d] or keys[pygame.K_RIGHT]:
            dx += 1

        if dx == 0 and dy == 0:
            dx = self.last_dx
            dy = self.last_dy
        else:
            length = math.hypot(dx, dy)
            dx /= length
            dy /= length

        self.x += dx * 130
        self.y += dy * 130

        self.x = clamp(
            self.x,
            self.radius,
            WIDTH - self.radius
        )

        self.y = clamp(
            self.y,
            self.radius,
            HEIGHT - self.radius
        )

        self.dash_cooldown = 1.5
        self.invincible = 0.25

    def take_damage(self, amount):
        if self.invincible > 0:
            return False

        self.health -= amount
        self.invincible = 0.7

        return True

    def add_xp(self, amount):
        self.xp += amount

        leveled_up = False

        while self.xp >= self.xp_needed:
            self.xp -= self.xp_needed
            self.level += 1

            self.xp_needed = int(self.xp_needed * 1.25)

            # Upgrade player
            self.max_health += 15
            self.health = self.max_health

            self.damage += 7
            self.fire_rate = max(0.08, self.fire_rate - 0.015)
            self.speed += 8

            leveled_up = True

        return leveled_up

    def draw(self):
        # Blink while invincible
        if self.invincible > 0:
            if int(self.invincible * 20) % 2 == 0:
                return

        pygame.draw.circle(
            screen,
            BLUE,
            (int(self.x), int(self.y)),
            self.radius
        )

        # Direction indicator
        end_x = self.x + self.last_dx * 30
        end_y = self.y + self.last_dy * 30

        pygame.draw.line(
            screen,
            WHITE,
            (int(self.x), int(self.y)),
            (int(end_x), int(end_y)),
            5
        )


