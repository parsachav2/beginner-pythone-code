# ============================================================
# Reset game
# ============================================================

def reset_game():
    global player
    global bullets, enemies, coins, gems, particles
    global wave, enemies_to_spawn, spawned_this_wave
    global spawn_timer, score
    global game_state
    global message, message_timer

    player = Player()

    bullets = []
    enemies = []
    coins = []
    gems = []
    particles = []

    wave = 1
    enemies_to_spawn = 8
    spawned_this_wave = 0
    spawn_timer = 0

    score = 0

    message = "SURVIVE!"
    message_timer = 2

    game_state = PLAYING


# ============================================================
# Spawn effects
# ============================================================

def create_particles(x, y, color, amount=12):
    for _ in range(amount):
        particles.append(
            Particle(x, y, color)
        )


# ============================================================
# Draw background
# ============================================================

def draw_background():
    screen.fill(DARK)

    # Dungeon floor tiles
    tile = 50

    for x in range(0, WIDTH, tile):
        for y in range(0, HEIGHT, tile):
            rect = pygame.Rect(x, y, tile, tile)

            if (x // tile + y // tile) % 2 == 0:
                pygame.draw.rect(
                    screen,
                    (29, 31, 40),
                    rect
                )
            else:
                pygame.draw.rect(
                    screen,
                    (26, 28, 36),
                    rect
                )

            pygame.draw.rect(
                screen,
                (35, 37, 47),
                rect,
                1
            )

    # Decorative dots
    random.seed(12345)

    for _ in range(80):
        x = random.randint(0, WIDTH)
        y = random.randint(0, HEIGHT)

        pygame.draw.circle(
            screen,
            (45, 47, 57),
            (x, y),
            2
        )

    random.seed()


